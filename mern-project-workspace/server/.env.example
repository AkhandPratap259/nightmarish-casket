# Copy to .env for local development. Dev defaults only — never commit real secrets.
PORT=5000
MONGO_URI=
JWT_SECRET=dev-only-flowboard-secret-change-in-production
CLIENT_URL=http://localhost:5173
# On Windows on ARM, keep MONGOMS_ARCH=x64 so the in-memory MongoDB download works.
# On a non-ARM machine this line can be removed. Set MONGO_URI to use Atlas instead.
MONGOMS_ARCH=x64
