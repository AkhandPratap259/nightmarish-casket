# FlowBoard local-development defaults ONLY — safe to commit.
# Never put a real MongoDB Atlas connection string, password or API key here.
# A real Atlas URI, if you want one, goes in your own local copy only and must never be committed.
PORT=5000
MONGO_URI=
JWT_SECRET=dev-only-flowboard-secret-change-in-production
CLIENT_URL=http://localhost:5173
# Needed on Windows on ARM so the in-memory MongoDB download works.
# Remove this line on a non-ARM machine, or set MONGO_URI to a free Atlas M0 cluster instead.
MONGOMS_ARCH=x64
