# NestHunt — local development defaults ONLY.
# This file is safe to commit: it contains no real secrets.
# To use a real database, set MONGO_URI in your OWN local copy only —
# never commit a real Atlas connection string or password.
PORT=5000
MONGO_URI=
JWT_SECRET=dev-only-secret-change-me
CLIENT_URL=http://localhost:5173
MONGOMS_ARCH=x64
