# PaisaPilot — local development defaults ONLY.
# This file is intentionally committed so the project runs out of the box.
# NEVER put a real MongoDB Atlas connection string, password, or API key here.
# A real Atlas URI, if you want one, goes in your OWN local copy only and
# must never be committed to a public repository.
PORT=5000
MONGO_URI=
JWT_SECRET=paisapilot-dev-secret-change-me
CLIENT_URL=http://localhost:5173
# Forces the x64 mongod binary for the in-memory fallback on Windows on ARM.
# Safe to remove on a non-ARM machine.
MONGOMS_ARCH=x64
