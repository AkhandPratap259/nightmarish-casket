# TaskTrove server — local development defaults.
# Copy this file to .env if it is missing. A real MongoDB Atlas URI, if you
# want one, goes in your own local copy only and must never be committed.
PORT=5000
# Leave empty to use the in-memory MongoDB fallback (development only).
MONGO_URI=
JWT_SECRET=tasktrove-dev-secret-change-me
CLIENT_URL=http://localhost:5173
# Forces the x64 mongod binary for the in-memory fallback on Windows on ARM.
MONGOMS_ARCH=x64
